# Example server block for a static `out/` export.
# Copy this into the active nginx site configuration and adjust the root path.
server {
    listen 80;
    listen [::]:80;
    server_name simonarapoglu.com www.simonarapoglu.com;

    root /var/www/simonarapoglu.com;
    index index.html;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(?:mp4|webm|ogg|mov)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|pdf)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
